// ==========================================================
// REGLAS DE FIRESTORE
// ==========================================================
// Cómo usarlas:
// 1. Ve a Firebase Console > Firestore Database > Reglas
// 2. Reemplaza todo el contenido por lo de abajo
// 3. Publica
// ==========================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede crear/editar SU PROPIO documento.
    // Cualquiera que esté logueado puede leer (para poder calcular el ranking).
    match /usuarios/{usuarioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == usuarioId;
      allow update: if request.auth != null && request.auth.uid == usuarioId;
      allow delete: if false;
    }

    // Cualquier usuario logueado puede registrar SU propio progreso.
    // Nadie puede editar o borrar progreso ya guardado (evita hacer trampa).
    match /progreso/{progresoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }

    // El ranking actual (colegios) lo puede leer cualquiera logueado,
    // y se recalcula automáticamente cada vez que alguien completa un cuestionario.
    match /rankingActual/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // El ranking personal (particulares + estudiantes) también es
    // visible para cualquiera logueado, y se recalcula automáticamente.
    match /rankingPersonal/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Contenido de las lecturas (sistema de premios QR). Cualquiera
    // logueado puede leerlas, pero solo la cuenta administradora puede
    // crear, editar o borrar — así el panel de administrador funciona
    // solo para esa cuenta, sin importar lo que alguien intente hacer
    // manipulando el código desde el navegador.
    match /lecturas/{lecturaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "joserodrigo.jrqd@gmail.com";
    }

    // Contenido de "Mejorar la lectura". Mismo criterio que /lecturas.
    match /mejoraLecturas/{lecturaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "joserodrigo.jrqd@gmail.com";
    }

    // Configuración general (por ahora, el rango de edades de
    // "Mejorar la lectura"). Mismo criterio.
    match /configuracion/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "joserodrigo.jrqd@gmail.com";
    }
  }
}
