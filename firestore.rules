// ==========================================================
// REGLAS DE FIRESTORE
// ==========================================================
// Cómo usarlas:
// 1. Ve a Firebase Console > Firestore Database > Reglas
// 2. Reemplaza todo el contenido por lo de abajo
// 3. Publica
// ==========================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Administradores (panel de admin, catálogo, configuración). Ya no es
    // un solo correo hardcodeado: se revisa membresía en la colección
    // "administradores" (un documento por correo, con el correo mismo
    // como ID — ver más abajo). Cualquier correo con documento ahí puede
    // escribir esas colecciones.
    function esAdmin() {
      return request.auth != null
             && exists(/databases/$(database)/documents/administradores/$(request.auth.token.email));
    }

    // Los "premiadores" son las cuentas autorizadas para canjear premios
    // (ver premiador.html). La lista de correos vive en
    // configuracion/premiadores y la edita el admin desde el panel.
    function esPremiador() {
      return request.auth != null
             && exists(/databases/$(database)/documents/configuracion/premiadores)
             && request.auth.token.email in
                get(/databases/$(database)/documents/configuracion/premiadores).data.emails;
    }

    // ¿El usuario es coordinador de este colegio?
    function esCoordinadorDe(colegioId) {
      return request.auth != null
             && get(/databases/$(database)/documents/colegios/$(colegioId)).data.correoCoordinador == request.auth.token.email;
    }

    // ¿El usuario es maestro de esta sección en este colegio?
    function esMaestroDe(colegioId, seccionId) {
      return request.auth != null
             && get(/databases/$(database)/documents/colegios/$(colegioId)/secciones/$(seccionId)).data.correoMaestro == request.auth.token.email;
    }

    // Cada usuario solo puede crear/editar SU PROPIO documento.
    // Cualquiera que esté logueado puede leer (para poder calcular el ranking).
    // El administrador también puede actualizar el campo "puntosTotales"
    // de CUALQUIER usuario (y solo ese campo) — se usa al eliminar una
    // lectura del catálogo, para restarle a cada quien los puntos que
    // había ganado con ella y que el ranking quede correcto.
    match /usuarios/{usuarioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == usuarioId;
      allow update: if request.auth != null && (
                      request.auth.uid == usuarioId ||
                      (esAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["puntosTotales"]))
                    );
      allow delete: if false;
    }

    // Cualquier usuario logueado puede registrar SU propio progreso.
    // Nadie puede editar progreso ya guardado (evita hacer trampa), pero
    // el administrador sí puede BORRAR entradas de progreso cuando la
    // lectura a la que pertenecen se elimina del catálogo.
    match /progreso/{progresoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid;
      allow update: if false;
      allow delete: if esAdmin();
    }

    // El ranking actual (colegios) lo puede leer cualquiera logueado,
    // y se recalcula automáticamente cada vez que alguien completa un cuestionario.
    match /rankingActual/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // El ranking personal (particulares + estudiantes) también es
    // visible para cualquiera logueado, y se recalcula automáticamente.
    match /rankingPersonal/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Ranking de "El premio gordo" (racha de lecturas difíciles seguidas
    // con 3 estrellas). Mismo criterio que los dos anteriores: se
    // recalcula solo, disparado por el propio intento de cada usuario.
    match /rankingPremioGordo/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Mejor tiempo registrado por lectura, entre quienes la aprobaron
    // (Etapa 34, ver actualizarMejorTiempoLectura en puntos.js). Un solo
    // documento por lectura, se recalcula solo cada vez que alguien la
    // aprueba — mismo criterio que los rankings de arriba.
    match /mejoresTiemposLectura/{lecturaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Contenido de las lecturas (sistema de premios QR). Cualquiera
    // logueado puede leerlas, pero solo la cuenta administradora puede
    // crear, editar o borrar — así el panel de administrador funciona
    // solo para esa cuenta, sin importar lo que alguien intente hacer
    // manipulando el código desde el navegador.
    // El admin puede escribir cualquier campo. Cualquier otro usuario
    // logueado SOLO puede incrementar "vistas" (contador de cuántas veces
    // se abrió — ver motor.js y "Mis publicaciones" en perfil.js), mismo
    // patrón que la regla de /usuarios que limita al admin a un solo
    // campo (puntosTotales).
    match /lecturas/{lecturaId} {
      allow read: if request.auth != null;
      allow write: if esAdmin() ||
                   (request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vistas"]));
      // El AUTOR de una lectura que vino de "Ser el protagonista de la
      // historia" (tiene autorUid) puede BORRAR LA SUYA — desde
      // "Sugerencias" (ver sugerencias.js). El admin puede borrar
      // cualquiera; la borra desde el panel con eliminarLectura(), que
      // además revierte puntos y limpia "progreso" (ver admin.js /
      // puntos.js). El borrado del autor NO hace esa limpieza, por eso
      // sugerencias.js solo ofrece el botón mientras nadie tenga
      // "progreso" en esa lectura.
      allow delete: if esAdmin() ||
                    (request.auth != null && resource.data.autorUid == request.auth.uid);
    }

    // Contenido de "Mejorar la lectura". Mismo criterio que /lecturas.
    match /mejoraLecturas/{lecturaId} {
      allow read: if request.auth != null;
      allow write: if esAdmin() ||
                   (request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(["vistas"]));
    }

    // Configuración general (rango de edades, descripción de premios,
    // lista de premiadores, meta de El premio gordo). Mismo criterio.
    match /configuracion/{configId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // Cuántos usuarios eligieron cada tema de interés (Etapa 37) — se
    // muestra como contador en vivo junto a cada tema en el registro
    // (ver registro.js). Un documento por tema, con un solo campo
    // "conteo" que cada usuario incrementa al registrarse o al cambiar
    // sus temas desde Perfil. Mismo criterio que rankingPersonal: es un
    // dato derivado y público, no algo que haya que proteger por
    // usuario, así que cualquiera logueado puede sumarle.
    // La LISTA de temas válidos NO se toca desde aquí: vive en
    // configuracion/generosLectura y solo la escriben el admin o la
    // Cloud Function que modera los temas nuevos (ver moderarTemaIA.js).
    match /temasContadores/{tema} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // "El Hilo del día": el contenido de cada día (5 fragmentos en su
    // orden correcto) lo administra solo el admin, igual que /lecturas.
    match /elHiloDelDia/{fecha} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // El intento del día de cada usuario (ver hilo-del-dia.js) — mismo
    // nivel de confianza que /progreso: cada quien lee y escribe SOLO
    // su propio documento (el ID ya lo compone el cliente como
    // "{uid}_{fecha}", pero además se exige que el campo "uid" adentro
    // coincida, por si acaso). "resource == null" cubre el caso de
    // revisar si el documento de hoy existe TODAVÍA (antes de jugar la
    // primera vez) — sin eso, leer algo que no existe truena la regla
    // en vez de simplemente devolver "no existe".
    match /intentosHiloDia/{id} {
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid == resource.data.uid);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.uid
                    && request.auth.uid == request.resource.data.uid;
      allow delete: if false;
    }

    // Banco de palabras de Ahorcado. Mismo criterio que /lecturas: lo
    // administra solo el admin, cualquier logueado puede leerlo para
    // poder jugar.
    match /bancoPalabras/{palabraId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // Historial de Excels importados al banco de Ahorcado (nombre, fecha,
    // cuántas palabras trajo, enlace de descarga del archivo guardado en
    // Storage — ver archivarExcelImportado en admin.js). Solo el admin.
    match /importacionesBancoAhorcado/{id} {
      allow read: if esAdmin();
      allow write: if esAdmin();
    }

    // Premios canjeables: uno por cada lectura aprobada por primera vez,
    // con su código de 6 dígitos. Cualquiera logueado puede leer (mismo
    // criterio que "progreso") — se necesita para que, al generar un
    // código nuevo, se pueda revisar que no esté repetido, para que el
    // Premiador pueda buscar cualquier código, y para poder sumar el
    // conteo global de donaciones (ver premios.js) sobre TODOS los
    // usuarios, no solo el propio.
    //
    // Canjear y donar son dos caminos EXCLUYENTES para un mismo premio,
    // y cada uno solo se puede activar una vez (de false a true):
    // - Un premiador puede marcarlo canjeado, pero no si ya fue donado.
    // - El dueño del premio puede marcarlo donado (él mismo, nadie más),
    //   pero no si ya fue canjeado.
    // Ninguno de los dos puede tocar más campos que los estrictamente
    // necesarios para su propia acción. Los premios creados ANTES de que
    // existiera "donado" no tienen ese campo — se usa resource.data.get()
    // con un valor por defecto (en vez de resource.data.donado directo)
    // para que leerlo en esos documentos viejos no truene la regla.
    match /premios/{premioId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.usuarioId == request.auth.uid
                    && request.resource.data.canjeado == false
                    && request.resource.data.donado == false;
      allow update: if
                    (esPremiador()
                      && resource.data.canjeado == false
                      && resource.data.get('donado', false) == false
                      && request.resource.data.canjeado == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["canjeado", "canjeadoPor", "fechaCanjeado"]))
                    ||
                    (request.auth != null
                      && request.auth.uid == resource.data.usuarioId
                      && resource.data.canjeado == false
                      && resource.data.get('donado', false) == false
                      && request.resource.data.donado == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["donado", "fechaDonado"]));
      allow delete: if false;
    }

    // Códigos de 8 caracteres (uno por golosina) que desbloquean el
    // ACCESO a una lectura de premio — el documento se identifica por el
    // código mismo, así que su sola existencia como ID ya garantiza que
    // no se repita. Cualquiera logueado puede leerlos (para poder
    // revisarlos, aunque la app normalmente los busca por ID exacto).
    // Solo el admin puede crearlos o borrarlos desde el panel. Cualquier
    // usuario logueado puede "canjear" uno (marcarlo usado), pero SOLO
    // cambiando su propio código de disponible (false) a usado (true),
    // dejando el resto de los campos intactos — nunca al revés, y nunca
    // el código de otra persona.
    match /codigosLectura/{codigo} {
      allow read: if request.auth != null;
      allow create: if esAdmin();
      allow update: if request.auth != null
                    && resource.data.usado == false
                    && request.resource.data.usado == true
                    && request.resource.data.usadoPor == request.auth.uid
                    && request.resource.data.lecturaId == resource.data.lecturaId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["usado", "usadoPor", "usadoEn"]);
      allow delete: if esAdmin();
    }

    // Administradores del panel — un documento por correo, usando el
    // correo mismo como ID (ver esAdmin() arriba). Solo un admin puede
    // ver la lista o agregar uno nuevo, y siempre con esPrincipal: false
    // (nadie puede auto-otorgarse ni otorgarle a otro el estatus de
    // principal desde la app). Nadie puede EDITAR un documento ya creado
    // (así nadie puede degradar al principal cambiándole ese campo), y
    // nadie puede ELIMINAR uno cuyo esPrincipal sea true — ni el dueño de
    // esa cuenta ni ningún otro administrador, pase lo que pase en la
    // interfaz.
    match /administradores/{correoAdmin} {
      allow read: if esAdmin();
      allow create: if esAdmin() && request.resource.data.esPrincipal == false;
      allow update: if false;
      allow delete: if esAdmin() && resource.data.esPrincipal == false;
    }

    // Propuestas de "Ser el protagonista de la historia" (ver
    // protagonista.js / admin-panel.js): cola de revisión, separada del
    // catálogo real. Cada quien puede crear y leer SUS PROPIAS
    // propuestas (para saber que se enviaron); el admin puede leer todas
    // para revisarlas. Nadie edita una propuesta ya enviada — "publicar"
    // crea una lectura nueva en /lecturas o /mejoraLecturas (ya requiere
    // esAdmin) y borra la propuesta; "rechazar" solo la borra.
    match /propuestasLecturas/{propuestaId} {
      allow read: if request.auth != null &&
                  (esAdmin() || resource.data.autorUid == request.auth.uid);
      allow create: if request.auth != null &&
                    request.resource.data.autorUid == request.auth.uid;
      allow update: if false;
      allow delete: if esAdmin();
    }

    // Registro de uso/costo de IA (Etapa 37, ver registrarUsoIA.js) —
    // SOLO el admin puede leerlo, para ver el panel de costos. Nadie
    // escribe aquí desde el navegador nunca — solo la Cloud Function
    // correspondiente, con el Admin SDK (que no pasa por estas reglas).
    match /usoIA/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // "Librería de respuestas" del panel de Análisis con IA (Etapa 37,
    // ver analizarDatosUsuariosIA.js) — mismo criterio que /usoIA: solo
    // lectura para el admin, y solo la Cloud Function escribe aquí.
    match /analisisIA/{id} {
      allow read: if esAdmin();
      allow write: if false;
    }

    // Colegios: el admin los crea y administra. El coordinador de cada
    // colegio puede leer el suyo. Cualquier usuario autenticado puede
    // leer para comprobar su vinculación.
    match /colegios/{colegioId} {
      allow read: if request.auth != null;
      allow create, update, delete: if esAdmin();
    }

    // Grados dentro de un colegio: el coordinador de ese colegio los
    // administra; el admin también puede.
    match /colegios/{colegioId}/grados/{gradoId} {
      allow read: if request.auth != null;
      allow create, update, delete: if esAdmin() || esCoordinadorDe(colegioId);
    }

    // Secciones dentro de un colegio: el coordinador las administra,
    // el maestro asignado puede leer la suya.
    match /colegios/{colegioId}/secciones/{seccionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if esAdmin() || esCoordinadorDe(colegioId);
    }

    // Biblioteca escolar: los maestros suben materiales, los alumnos
    // y coordinadores leen. El admin puede todo.
    match /bibliotecaEscolar/{archivoId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null
                            && (esAdmin() || resource.data.subidoPor == request.auth.uid);
    }

    // Tareas escolares: los maestros las crean, los alumnos las leen.
    match /tareasEscolares/{tareaId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if esAdmin();
    }

    // Progreso escolar: cada alumno escribe el suyo, el maestro y el
    // propio alumno pueden leerlo. El admin puede leer todo.
    match /progresoEscolar/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
