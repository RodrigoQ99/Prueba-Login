// ==========================================================
// REGLAS DE FIREBASE STORAGE
// ==========================================================
// Cómo usarlas: igual que firestore.rules — Firebase Console >
// Storage > Reglas > pega esto > Publica. (O "firebase deploy --only
// storage" desde este proyecto, ver firebase.json).
//
// Dos carpetas en uso, las dos exclusivas para administradores:
//
// - "fuentesLecturas/": el admin sube un documento (PDF/Word/txt) para
//   que una Cloud Function (extraerLecturaDeDocumentoIA) le extraiga
//   el texto y arme el formulario de creación de lectura. Es un
//   archivo de entrada TRANSITORIO — la función lo borra ella misma
//   apenas termina de leerlo.
//
// - "pdfsHiloDelDia/": PDFs que el admin guarda como fuente reusable
//   para "El Hilo del día" (ver extraerTextoDePdfGuardado). A
//   diferencia de la anterior, estos son PERMANENTES — se quedan
//   guardados para usarlos en varios Hilos a lo largo del tiempo,
//   hasta que el admin decida borrarlos a mano.
//
// - "fuentesPalabras/": documento con una lista de palabras (admin,
//   banco general de Ahorcado). TRANSITORIO, igual que fuentesLecturas/.
//
// - "fuentesGlosarioPersonal/{uid}/": documento con el glosario
//   personal de UN usuario para Ahorcado. A diferencia de todo lo
//   anterior, NO es exclusivo del admin — cualquier usuario autenticado
//   puede subir aquí, pero SOLO dentro de su propia subcarpeta (con su
//   propio uid) — nunca puede leer, subir ni borrar en la de otro
//   usuario. TRANSITORIO. Límites más chicos (2 MB) porque es la única
//   carpeta abierta a cualquiera, no solo al admin.
// ==========================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mismo criterio que esAdmin() en firestore.rules/admin-comun.js,
    // pero en el lenguaje de reglas de Storage: revisa la MISMA
    // colección "administradores" de Firestore vía firestore.exists()
    // (soporte cruzado Storage <-> Firestore de las reglas de
    // Firebase). Nadie más que un administrador autenticado puede
    // subir, leer o borrar nada en este bucket.
    function esAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/administradores/$(request.auth.token.email));
    }

    // Verbos por separado (en vez de "write") a propósito: una petición
    // de "delete" no trae request.resource, así que mezclar "write" con
    // esa referencia habría bloqueado el borrado.
    match /fuentesLecturas/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|'
                         + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
                         + 'text/plain'
                       );
      allow delete: if esAdmin();
    }

    match /pdfsHiloDelDia/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow delete: if esAdmin();
    }

    match /fuentesPalabras/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|'
                         + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
                         + 'text/plain'
                       );
      allow delete: if esAdmin();
    }

    // Cada usuario SOLO puede tocar su propia subcarpeta ({uid} debe
    // coincidir con su propio uid) — ni siquiera puede leer o borrar la
    // de otro, mucho menos subir ahí. Límite de tamaño más chico (2 MB)
    // y cantidad de palabras (revisada en la Cloud Function, no aquí)
    // porque es la única carpeta de este archivo abierta a cualquier
    // usuario, no solo al admin.
    match /fuentesGlosarioPersonal/{uid}/{archivo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 2 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|'
                         + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
                         + 'text/plain'
                       );
    }

    // Por defecto, cualquier otra ruta del bucket queda cerrada — se
    // van agregando carpetas específicas (con su propia regla) según
    // se necesiten, nunca un "allow read, write: if true" general.
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
