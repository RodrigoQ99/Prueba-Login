// ==========================================================
// REGLAS DE FIREBASE STORAGE
// ==========================================================
// Cómo usarlas: igual que firestore.rules — Firebase Console >
// Storage > Reglas > pega esto > Publica. (O "firebase deploy --only
// storage" desde este proyecto, ver firebase.json).
//
// Todas las carpetas de abajo son EXCLUSIVAS de administradores — desde
// la Etapa 29 ningún usuario normal puede subir nada a este bucket (se
// cerró "fuentesGlosarioPersonal/", la única que antes estaba abierta a
// cualquiera; ver la nota comentada más abajo).
//
// - "fuentesLecturas/": SIN USO desde la Etapa 28 (ver la nota junto a
//   su regla) — el admin ya no puede crear lecturas subiendo un
//   documento.
//
// - "pdfsHiloDelDia/": PDFs que el admin guarda como fuente reusable
//   para "El Hilo del día" (ver extraerTextoDePdfGuardado). PERMANENTES
//   — se quedan guardados para usarlos en varios Hilos a lo largo del
//   tiempo, hasta que el admin decida borrarlos a mano.
//
// - "fuentesPalabras/": SIN USO desde la Etapa 30 (ver la nota junto a
//   su regla) — el admin ya no carga palabras con IA, solo a mano o con
//   Excel (que no usa Storage).
// ==========================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mismo criterio que esAdmin() en firestore.rules/admin-comun.js,
    // pero en el lenguaje de reglas de Storage: revisa la MISMA
    // colección "administradores" de Firestore vía firestore.exists()
    // (soporte cruzado Storage <-> Firestore de las reglas de
    // Firebase). Nadie más que un administrador autenticado puede
    // subir, leer o borrar nada en este bucket.
    function esAdmin() {
      return request.auth != null &&
             firestore.exists(/databases/(default)/documents/administradores/$(request.auth.token.email));
    }

    // Verbos por separado (en vez de "write") a propósito: una petición
    // de "delete" no trae request.resource, así que mezclar "write" con
    // esa referencia habría bloqueado el borrado.
    // SIN USO desde la Etapa 28 — se quitó la opción de crear lecturas
    // subiendo un documento, y extraerLecturaDeDocumentoIA ya no está
    // desplegada (ver functions/index.js). Se deja la regla activa,
    // sin borrar, por si algún día se reactiva esa función.
    match /fuentesLecturas/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 15 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|'
                         + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
                         + 'text/plain'
                       );
      allow delete: if esAdmin();
    }

    match /pdfsHiloDelDia/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 20 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
      allow delete: if esAdmin();
    }

    // SIN USO desde la Etapa 30 — se quitó del panel la opción de
    // cargar palabras con IA (URL/documento); extraerPalabrasDeDocumentoIA
    // ya no está desplegada (ver functions/index.js). Se deja la regla
    // activa, sin borrar, por si algún día se reactiva esa función.
    match /fuentesPalabras/{archivo} {
      allow read: if esAdmin();
      allow create: if esAdmin()
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches(
                         'application/pdf|'
                         + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
                         + 'text/plain'
                       );
      allow delete: if esAdmin();
    }

    // CERRADA desde la Etapa 29 — el admin pidió que los usuarios ya NO
    // puedan subir ningún documento ni usar IA (eso queda exclusivo del
    // panel de administrador). Antes era la única carpeta de este
    // archivo abierta a cualquier usuario autenticado (para su glosario
    // personal de Ahorcado, ver ahorcado-ia.js — ahora desconectado).
    // Se deja la regla comentada, sin borrar, por si algún día se
    // retoma; al no tener ninguna regla activa, cae en el bloque
    // "cualquier otra ruta" de más abajo y queda bloqueada por completo.
    //
    // match /fuentesGlosarioPersonal/{uid}/{archivo} {
    //   allow read, delete: if request.auth != null && request.auth.uid == uid;
    //   allow create: if request.auth != null && request.auth.uid == uid
    //                 && request.resource.size < 2 * 1024 * 1024
    //                 && request.resource.contentType.matches(
    //                      'application/pdf|'
    //                      + 'application/vnd.openxmlformats-officedocument.wordprocessingml.document|'
    //                      + 'text/plain'
    //                    );
    // }

    // Por defecto, cualquier otra ruta del bucket queda cerrada — se
    // van agregando carpetas específicas (con su propia regla) según
    // se necesiten, nunca un "allow read, write: if true" general.
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
